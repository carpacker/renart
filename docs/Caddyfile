{
	auto_https off
}

:{$PORT:80} {
	root * /usr/share/caddy
	encode zstd gzip

	@install path /install.sh
	header @install Cache-Control "public, max-age=300"
	header @install Content-Type "text/x-shellscript; charset=utf-8"

	@immutable path /_astro/* /landing/* /icons/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Runtime tracking injection for static HTML.
	# Set RENART_TRACKING_HEAD to raw HTML such as analytics <script> tags.
	# For build-time injection instead, set PUBLIC_RENART_TRACKING_HEAD before `astro build`.
	templates {
		mime text/html
	}

	file_server
}
