---
import 'asciinema-player/dist/bundle/asciinema-player.css';

interface Props {
  src: string;
  label: string;
  caption?: string;
  rows?: number;
}

const { src, label, caption, rows } = Astro.props;
---

<figure class="terminal-recording" aria-label={label}>
  <div
    class="terminal-recording__player"
    data-terminal-recording
    data-src={src}
    data-rows={rows}
  >
    <noscript>
      <a href={src}>Download the terminal recording</a>
    </noscript>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import * as AsciinemaPlayer from 'asciinema-player';
  import type { Player } from 'asciinema-player';

  type RecordingHost = HTMLElement & { renartPlayer?: Player };

  function mountTerminalRecordings() {
    for (const host of document.querySelectorAll<RecordingHost>('[data-terminal-recording]')) {
      if (host.renartPlayer || !host.dataset.src) continue;
      const configuredRows = Number(host.dataset.rows);
      host.renartPlayer = AsciinemaPlayer.create(host.dataset.src, host, {
        controls: true,
        fit: 'width',
        idleTimeLimit: 1.5,
        poster: 'npt:0:01',
        preload: true,
        rows: Number.isFinite(configuredRows) && configuredRows > 0 ? configuredRows : undefined,
        speed: 1.25,
        terminalFontSize: 'small',
        theme: 'dracula',
      });
    }
  }

  mountTerminalRecordings();
  document.addEventListener('astro:page-load', mountTerminalRecordings);
  document.addEventListener('astro:before-swap', () => {
    for (const host of document.querySelectorAll<RecordingHost>('[data-terminal-recording]')) {
      host.renartPlayer?.dispose();
      delete host.renartPlayer;
    }
  });
</script>

<style>
  .terminal-recording {
    margin-block: 1.5rem;
  }

  .terminal-recording__player {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: #191a21;
    box-shadow: 0 1rem 2.5rem rgb(15 23 42 / 14%);
  }

  figcaption {
    margin-top: 0.65rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
