---
import DefaultHead from '@astrojs/starlight/components/Head.astro';

const trackingHead = import.meta.env.PUBLIC_RENART_TRACKING_HEAD?.trim() || '{{env "RENART_TRACKING_HEAD"}}';
const robots = Astro.url.pathname === '/404/' ? 'noindex, nofollow' : 'index, follow';
---

<DefaultHead />
<meta name="robots" content={robots} />
<Fragment set:html={trackingHead} />
