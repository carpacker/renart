---
import { execSync } from 'node:child_process';

const repoUrl = 'https://github.com/renart-data/renart';
const bruinUrl = 'https://github.com/bruin-data/bruin';
const installCommand = 'curl -LsSf getrenart.com/install.sh | sh';

function readGitValue(command: string, fallback: string) {
  try {
    return execSync(command, { cwd: new URL('../../..', import.meta.url), stdio: ['ignore', 'pipe', 'ignore'] })
      .toString()
      .trim() || fallback;
  } catch {
    return fallback;
  }
}

const latestVersion = process.env.RENART_VERSION || readGitValue('git describe --tags --abbrev=0', 'local build');
const commit = process.env.RENART_COMMIT || readGitValue('git rev-parse --short HEAD', 'unknown');
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Renart is a fast visual workspace for Bruin projects." />
    <title>Renart - The visual workspace for Bruin projects</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a href="/" class="logo" aria-label="Renart home">
          <img class="logo-mark" src="/icons/icon.svg" alt="" width="22" height="22" />
          renart
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a class="nav-link" href="#features">Features</a>
          <a class="nav-link" href="#bruin">Bruin</a>
          <a class="nav-link" href="#workflow">Workflow</a>
          <a class="nav-link" href="/docs/">Docs</a>
        </nav>
        <div class="nav-right">
          <a class="nav-stars" href={repoUrl}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
            GitHub
          </a>
          <a class="nav-cta" href="/docs/installation/">Get started</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <span class="hero-eyebrow">
          <span class="pip"></span>
          <strong>{latestVersion}</strong>
          <span class="sep">/</span>
          Open source / Apache 2.0
        </span>

        <h1>
          The visual workspace<br />
          for <em>Bruin pipelines</em>
        </h1>

        <p class="hero-sub">
          Renart gives Git-backed <a href={bruinUrl}>Bruin</a> projects a fast visual editor for assets, dependencies, lineage, SQL inspection, and materialization.
        </p>

        <div class="ctas">
          <a href="/docs/installation/" class="btn btn-primary">Get started</a>
          <a href="/docs/" class="btn btn-ghost">Read the docs <span class="arrow">-&gt;</span></a>
        </div>

        <div class="install" id="install">
          <span class="install-cmd">
            <span class="prompt">$</span>
            <span>{installCommand}</span>
          </span>
          <button class="install-copy" type="button" data-copy-command={installCommand}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M3 11V4a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.4" /></svg>
            <span class="copy-label">copy</span>
          </button>
        </div>

        <div class="hero-media">
          <video autoplay muted loop playsinline poster="/landing/feature-dag-canvas.png">
            <source src="/landing/hero-canvas-roundtrip.webm" type="video/webm" />
          </video>
        </div>
      </section>

      <div class="marquee-wrap" aria-label="Supported data stack examples">
        <div class="marquee-label">Works with Bruin projects connected to your existing stack</div>
        <div class="marquee">
          {['BigQuery', 'Snowflake', 'Postgres', 'DuckDB', 'Stripe', 'Salesforce', 'S3', 'Redshift', 'HTTP APIs', 'Git'].concat(['BigQuery', 'Snowflake', 'Postgres', 'DuckDB', 'Stripe', 'Salesforce', 'S3', 'Redshift', 'HTTP APIs', 'Git']).map((item) => (
            <span class="marquee-item"><span class="ico"></span>{item}</span>
          ))}
        </div>
      </div>

      <section class="block" id="features">
        <div class="eyebrow"><span class="bar"></span> Why Renart</div>
        <h2 class="h2">A visual editor that still respects <em>real files</em>.</h2>
        <p class="lede">
          Renart does not replace Bruin or hide your project behind a proprietary model. It reads and writes the same repository files your team reviews, runs, and commits.
        </p>

        <div class="bento">
          <article class="card span-3">
            <div class="card-visual image-pad">
              <img src="/landing/feature-intellisense.png" alt="Monaco editor showing Renart SQL IntelliSense suggestions while typing HAVING order_" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-tag">IntelliSense</div>
              <h3>Column-aware SQL completion</h3>
              <p>Renart surfaces Monaco completions from the current Bruin workspace context, including useful suggestions as you type.</p>
            </div>
          </article>

          <article class="card span-3">
            <div class="card-visual image-pad">
              <img src="/landing/feature-validation.png" alt="Monaco editor showing SQL validation hover for an unresolved column" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-tag">Validation</div>
              <h3>SQL feedback before runtime</h3>
              <p>Catch unresolved columns and similar mistakes in the editor, then jump straight to the relevant line instead of waiting for a failed run.</p>
            </div>
          </article>

          <article class="card span-2">
            <div class="card-visual media-fill">
              <img src="/landing/feature-jump-to-def.gif" alt="Renart editor navigating from a SQL reference to its definition" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-tag">Navigation</div>
              <h3>Jump to referenced assets</h3>
              <p>Move from a dependency reference to the source asset without leaving the visual workspace.</p>
            </div>
          </article>

          <article class="card span-4">
            <div class="card-visual media-fill">
              <img src="/landing/feature-dag-canvas.png" alt="Renart DAG canvas showing connected Bruin assets" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-tag">Canvas</div>
              <h3>The DAG is the workspace</h3>
              <p>Use the canvas to understand assets, dependencies, and data flow at a glance, then open any node to edit the underlying Bruin asset.</p>
            </div>
          </article>

          <article class="card span-6 workflow-card" id="workflow">
            <div class="workflow-grid">
              <div>
                <div class="card-tag">Execution</div>
                <h3>Inspect safely, materialize intentionally</h3>
                <p>Inspect is the conservative preview path. Materialization is the explicit execution path for changes that produce side effects.</p>
              </div>
              <div>
                <div class="card-tag">Sync</div>
                <h3>Filesystem state wins</h3>
                <p>The Go server watches workspace files and streams updates to the frontend over SSE, so external edits and CLI activity reconcile back into the UI.</p>
              </div>
              <div>
                <div class="card-tag">Git</div>
                <h3>Built for repositories</h3>
                <p>Renart is designed to start inside a Git repository and keep visual edits reviewable as normal project file changes.</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="manifesto">
        <blockquote>
          Your pipeline should not be something you have to <em>imagine in your head</em> while reading YAML and SQL files.
        </blockquote>
        <div class="attrib">The thesis behind Renart</div>
      </section>

      <section class="block bruin" id="bruin">
        <div class="eyebrow"><span class="bar"></span> Built on Bruin</div>
        <h2 class="h2">Not another abstraction layer. <em>A better interface</em> to the real thing.</h2>
        <p class="lede">
          Every pipeline you build in Renart remains a native Bruin project: real files on disk, runnable from the CLI, and ready for Git review.
        </p>

        <div class="bruin-grid">
          <div class="bruin-list">
            <div class="bruin-row"><span class="check">✓</span><span><b>Bruin assets on disk.</b> Edit SQL, Python, and YAML files through a visual workspace.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>Go server as the filesystem path.</b> File-changing actions go through Renart backend APIs.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>SSE-driven reconciliation.</b> Workspace events keep frontend state aligned with files.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>Inspect and materialize.</b> Preview results safely, then run assets intentionally when needed.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>Canvas-first lineage.</b> Understand dependencies visually while staying close to source files.</span></div>
          </div>
          <div class="bruin-illus" aria-hidden="true">
            <svg viewBox="0 0 360 340" preserveAspectRatio="xMidYMid meet">
              <path d="M180 60 L180 130" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 3" fill="none" />
              <path d="M180 180 L180 260" stroke="var(--line-3)" stroke-width="1.2" fill="none" />
              <path d="M120 285 L240 285" stroke="var(--line-3)" stroke-width="1.2" fill="none" stroke-dasharray="3 3" />
            </svg>
            <div class="bruin-pill renart" style="top: 32px; left: 50%; transform: translateX(-50%);"><span class="ico">R</span>Renart</div>
            <div class="bruin-pill bruin" style="top: 134px; left: 50%; transform: translateX(-50%);"><span class="ico">B</span>Bruin project</div>
            <div class="bruin-pill git" style="top: 250px; left: 24px;"><span class="ico">G</span>Git repo</div>
            <div class="bruin-pill wh" style="top: 250px; right: 24px;"><span class="ico">W</span>Warehouse</div>
          </div>
        </div>
      </section>

      <section class="final">
        <h2>Start building <em>visibly</em>.</h2>
        <p>Install Renart, open a Git-backed Bruin project, and inspect your first pipeline from the canvas.</p>
        <div class="ctas">
          <a href="/docs/installation/" class="btn btn-primary">Get started</a>
          <a href={repoUrl} class="btn btn-ghost">View on GitHub <span class="arrow">-&gt;</span></a>
        </div>
        <div class="install install-final">
          <span class="install-cmd"><span class="prompt">$</span><span>{installCommand}</span></span>
          <button class="install-copy" type="button" data-copy-command={installCommand}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M3 11V4a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.4" /></svg>
            <span class="copy-label">copy</span>
          </button>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="foot-brand">
          <a href="/" class="logo"><img class="logo-mark" src="/icons/icon.svg" alt="" width="22" height="22" />renart</a>
          <p>A fast visual workspace for Bruin projects. Open source under Apache 2.0.</p>
        </div>
        <div class="foot-col">
          <h5>Product</h5>
          <ul>
            <li><a href="#features">Features</a></li>
            <li><a href="#workflow">Workflow</a></li>
            <li><a href="#bruin">Bruin</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h5>Resources</h5>
          <ul>
            <li><a href="/docs/">Docs</a></li>
            <li><a href="/docs/installation/">Installation</a></li>
            <li><a href="/docs/quickstart/">Quickstart</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h5>Community</h5>
          <ul>
            <li><a href={repoUrl}>GitHub</a></li>
            <li><a href={bruinUrl}>Bruin</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {currentYear} Renart / Apache 2.0</span>
        <div class="meta">
          <span>build {commit}</span>
          <span class="sep">/</span>
          <span>{latestVersion}</span>
        </div>
      </div>
    </footer>

    <div class="toast" id="toast">copied to clipboard</div>

    <script is:inline>
      document.querySelectorAll('.install-copy').forEach((button) => {
        button.addEventListener('click', async () => {
          const command = button.getAttribute('data-copy-command') || '';
          await navigator.clipboard?.writeText(command);
          document.querySelectorAll('.install-copy').forEach((copyButton) => {
            copyButton.classList.add('copied');
            const label = copyButton.querySelector('.copy-label');
            if (label) label.textContent = 'copied';
            window.setTimeout(() => {
              copyButton.classList.remove('copied');
              if (label) label.textContent = 'copy';
            }, 1400);
          });
          const toast = document.getElementById('toast');
          toast?.classList.add('show');
          window.clearTimeout(window.__renartToastTimeout);
          window.__renartToastTimeout = window.setTimeout(() => toast?.classList.remove('show'), 1600);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0d0c;
    --bg-1: #0f1211;
    --bg-2: #14181a;
    --bg-3: #1a1f1d;
    --line: #1f2522;
    --line-2: #2a322e;
    --line-3: #3a4541;
    --fg: #e9ece9;
    --fg-2: #b9c1bd;
    --fg-3: #7a857f;
    --fg-4: #525c57;
    --fg-5: #3a423e;
    --accent: #6ee7a4;
    --accent-2: #34d17a;
    --accent-3: #1a6b2a;
    --accent-soft: rgba(110, 231, 164, 0.1);
    --accent-soft-2: rgba(110, 231, 164, 0.18);
    --accent-glow: rgba(52, 209, 122, 0.18);
    --warn: #f0b429;
    --serif: 'Instrument Serif', 'Times New Roman', serif;
    --sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
    --mono: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --r-1: 4px;
    --r-2: 6px;
    --r-3: 8px;
    --r-4: 12px;
    --r-5: 16px;
    --shadow-card: 0 1px 0 0 rgba(255, 255, 255, 0.03) inset, 0 12px 32px -16px rgba(0, 0, 0, 0.6);
    --shadow-pop: 0 24px 60px -16px rgba(0, 0, 0, 0.7), 0 0 0 1px var(--line);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -2;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: -1px -1px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 0%, transparent 70%);
    pointer-events: none;
  }
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 600px 400px at 50% -100px, var(--accent-glow), transparent 70%);
    pointer-events: none;
  }
  a { color: inherit; text-decoration: none; }
  code, .mono { font-family: var(--mono); font-size: 0.92em; }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(16px) saturate(1.4);
    background: rgba(11, 13, 12, 0.65);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 28px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .logo-mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: block;
    box-shadow: 0 0 0 1px var(--accent-soft-2), 0 4px 16px -4px var(--accent-glow);
  }
  .nav-links { display: flex; gap: 4px; align-items: center; margin-left: 12px; }
  .nav-link { padding: 6px 12px; font-size: 14px; color: var(--fg-3); border-radius: var(--r-2); transition: color 0.15s, background 0.15s; }
  .nav-link:hover { color: var(--fg); background: var(--bg-2); }
  .nav-right { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .nav-stars, .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--r-2);
    font-size: 13px;
    font-weight: 500;
  }
  .nav-stars { border: 1px solid var(--line-2); color: var(--fg-2); }
  .nav-stars svg { width: 14px; height: 14px; fill: currentColor; }
  .nav-cta { background: var(--fg); color: var(--bg); }

  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 144px 28px 80px;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 8px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg-1);
    font-size: 12px;
    color: var(--fg-3);
    margin-bottom: 36px;
    font-family: var(--mono);
  }
  .pip { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 3px var(--accent-soft), 0 0 12px var(--accent); }
  .hero-eyebrow strong { color: var(--fg-2); font-weight: 500; }
  .sep { color: var(--fg-5); }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(48px, 7.5vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
  }
  .hero h1 em, .h2 em, .final h2 em, .manifesto em { font-style: italic; color: var(--accent); }
  .hero-sub { font-size: 18px; color: var(--fg-2); max-width: 680px; margin: 0 auto 40px; text-wrap: pretty; }
  .hero-sub a { color: var(--accent); border-bottom: 1px solid var(--accent-soft-2); }
  .ctas { display: inline-flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: center; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--r-2);
    font-size: 14px;
    font-weight: 500;
    transition: transform 0.12s, background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .btn-primary { background: var(--fg); color: var(--bg); box-shadow: 0 1px 0 0 rgba(255, 255, 255, 0.4) inset, 0 8px 24px -8px rgba(255, 255, 255, 0.15); }
  .btn-primary:hover { background: #fff; transform: translateY(-1px); }
  .btn-ghost { color: var(--fg-2); border: 1px solid var(--line-2); }
  .btn-ghost:hover { color: var(--fg); border-color: var(--line-3); background: var(--bg-1); }
  .arrow { color: var(--fg-3); }

  .install {
    display: inline-flex;
    align-items: stretch;
    margin-top: 24px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-2);
    background: var(--bg-1);
    overflow: hidden;
    font-family: var(--mono);
    font-size: 13px;
  }
  .install-cmd { padding: 9px 16px 9px 14px; color: var(--fg-2); display: inline-flex; align-items: center; gap: 10px; }
  .prompt { color: var(--accent); user-select: none; }
  .install-copy {
    border: 0;
    border-left: 1px solid var(--line-2);
    padding: 0 14px;
    background: transparent;
    color: var(--fg-3);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .install-copy:hover, .install-copy.copied { color: var(--accent); background: var(--bg-2); }
  .install-copy svg { width: 12px; height: 12px; }

  .hero-media {
    margin: 72px auto 0;
    max-width: 1180px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-5);
    background: var(--bg-1);
    overflow: hidden;
    box-shadow: var(--shadow-pop);
    position: relative;
  }
  .hero-media::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 1px 0 var(--accent-soft-2);
  }
  .hero-media video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }

  .marquee-wrap { margin: 96px 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); overflow: hidden; background: var(--bg); position: relative; }
  .marquee-wrap::before, .marquee-wrap::after { content: ''; position: absolute; top: 0; bottom: 0; width: 120px; z-index: 2; pointer-events: none; }
  .marquee-wrap::before { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .marquee-wrap::after { right: 0; background: linear-gradient(-90deg, var(--bg), transparent); }
  .marquee-label { text-align: center; padding: 16px 0 4px; font-family: var(--mono); font-size: 11px; color: var(--fg-4); text-transform: uppercase; letter-spacing: 0.1em; }
  .marquee { display: flex; gap: 56px; padding: 18px 0 24px; animation: scroll 38s linear infinite; width: max-content; align-items: center; }
  @keyframes scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
