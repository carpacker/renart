---
import { execSync } from 'node:child_process';
import { Font, Image } from 'astro:assets';
import dagCanvas from '../assets/landing/feature-dag-canvas.png';
import intellisenseImage from '../assets/landing/feature-intellisense.png';
import validationImage from '../assets/landing/feature-validation.png';

const repoUrl = 'https://github.com/renart-data/renart';
const bruinUrl = 'https://github.com/bruin-data/bruin';
const installCommand = 'curl -LsSf getrenart.com/install.sh | sh';
const siteUrl = 'https://getrenart.com';
const pageTitle = 'Renart - Git-native data pipeline IDE';
const pageDescription = 'Renart is the git-native data pipeline IDE for Bruin projects: a visual canvas, editor, inspect, and execution workflow for version-controlled pipelines.';
const socialImage = `${siteUrl}/landing/feature-dag-canvas.png`;
const trackingHead = import.meta.env.PUBLIC_RENART_TRACKING_HEAD?.trim() || '{{env "RENART_TRACKING_HEAD"}}';

function readGitValue(command: string, fallback: string) {
  try {
    return execSync(command, { cwd: new URL('../../..', import.meta.url), stdio: ['ignore', 'pipe', 'ignore'] })
      .toString()
      .trim() || fallback;
  } catch {
    return fallback;
  }
}

const tagVersion = readGitValue('git describe --tags --abbrev=0', '0.0.0');
const commit = process.env.RENART_COMMIT || readGitValue('git rev-parse --short HEAD', 'unknown');
const explicitVersion = process.env.RENART_VERSION;
const latestVersion = explicitVersion && explicitVersion !== 'local build'
  ? explicitVersion
  : `${tagVersion}#${commit}`;
const currentYear = new Date().getFullYear();
const landingStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Renart',
      url: siteUrl,
      logo: `${siteUrl}/icons/icon.svg`,
      sameAs: [repoUrl],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Renart',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows',
      softwareVersion: latestVersion,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      url: siteUrl,
      codeRepository: repoUrl,
      description: pageDescription,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'WebSite',
      name: 'Renart',
      url: siteUrl,
      description: pageDescription,
      publisher: {
        '@type': 'Organization',
        name: 'Renart',
      },
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="application-name" content="Renart" />
    <meta name="apple-mobile-web-app-title" content="Renart" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Renart, Bruin, data pipeline IDE, git-native data pipelines, data engineering, analytics engineering, lineage canvas" />
    <meta name="author" content="Renart" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="canonical" href={siteUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Renart" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="Renart DAG canvas showing connected Bruin assets" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Renart DAG canvas showing connected Bruin assets" />
    <script is:inline type="application/ld+json" set:html={landingStructuredData}></script>
    <Fragment set:html={trackingHead} />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-instrument-serif" preload />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a href="/" class="logo" aria-label="Renart home">
          <img class="logo-mark" src="/icons/icon.svg" alt="" width="22" height="22" />
          renart
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a class="nav-link" href="#features">Features</a>
          <a class="nav-link" href="#bruin">Bruin</a>
          <a class="nav-link" href="#workflow">Workflow</a>
          <a class="nav-link" href="/docs/">Docs</a>
        </nav>
        <div class="nav-right">
          <a class="nav-stars nav-icon-link" href={repoUrl} aria-label="Renart GitHub project">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
          </a>
          <a class="nav-cta" href="/docs/installation/">Get started</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <span class="hero-eyebrow">
          <span class="pip"></span>
          <strong>{latestVersion}</strong>
          <span class="sep">/</span>
          <strong>alpha</strong>
          <span class="sep">/</span>
          Open source / Apache 2.0
        </span>

        <h1>
          The <span class="stroke">IDE</span><br />
          for <em>git-native data pipelines</em>
        </h1>

        <p class="hero-sub">
          Write SQL with real IntelliSense, visualize your pipeline as a live canvas, and run assets without leaving your repository. Built on <a href={bruinUrl}>Bruin</a>.
        </p>

        <div class="ctas">
          <a href="/docs/installation/" class="btn btn-primary">Get started</a>
          <a href="/docs/" class="btn btn-ghost">Read the docs <span class="arrow">-&gt;</span></a>
        </div>

        <div class="install" id="install">
          <span class="install-cmd">
            <span class="prompt">$</span>
            <span>{installCommand}</span>
          </span>
          <button class="install-copy" type="button" data-copy-command={installCommand}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M3 11V4a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.4" /></svg>
            <span class="copy-label">copy</span>
          </button>
        </div>

        <div class="hero-media">
          <Image class="hero-poster" src={dagCanvas} alt="Renart pipeline canvas and editor" widths={[360, 640, 960, 1180]} sizes="(max-width: 760px) calc(100vw - 40px), 1180px" format="webp" loading="eager" fetchpriority="high" decoding="async" />
          <video class="hero-video" autoplay muted loop playsinline preload="none" width="1920" height="1080" aria-label="Silent screen recording of Renart editing and running a pipeline">
            <source src="/landing/hero-canvas-roundtrip.webm" type="video/webm" media="(min-width: 761px)" />
            <track kind="captions" src="/landing/hero-canvas-roundtrip.vtt" srclang="en" label="English" default />
          </video>
        </div>
        <p class="hero-media-caption">Silent screen recording of Renart editing and running a pipeline.</p>
      </section>

      <div class="marquee-wrap" aria-label="Supported data stack examples">
        <div class="marquee-label">Works with git-native Bruin projects connected to your existing stack</div>
        <div class="marquee">
          {['BigQuery', 'Snowflake', 'Postgres', 'DuckDB', 'Stripe', 'Salesforce', 'S3', 'Redshift', 'HTTP APIs', 'Git'].concat(['BigQuery', 'Snowflake', 'Postgres', 'DuckDB', 'Stripe', 'Salesforce', 'S3', 'Redshift', 'HTTP APIs', 'Git']).map((item) => (
            <span class="marquee-item"><span class="ico"></span>{item}</span>
          ))}
        </div>
      </div>

      <section class="block" id="features">
        <div class="eyebrow"><span class="bar"></span> Why Renart</div>
        <h2 class="h2">A visual editor that writes <em>real files</em>.</h2>
        <p class="lede">
          Renart reads and writes the same repository files your team reviews, runs, and commits. It does not hide your pipeline behind a proprietary model or replace the tools you already trust.
        </p>
        <p class="lede lede-small">
          Renart is open source under Apache 2.0 and runs locally in your environment. No account, no hosted control plane, no cloud dependency.
        </p>

        <div class="bento">
          <article class="card span-3">
            <div class="card-visual image-pad">
              <Image src={intellisenseImage} alt="Monaco editor showing Renart SQL IntelliSense suggestions while typing HAVING order_" widths={[320, 480, 640]} sizes="(max-width: 1100px) calc(100vw - 88px), 512px" format="webp" loading="lazy" decoding="async" />
            </div>
            <div class="card-content">
              <div class="card-tag">IntelliSense</div>
              <h3>Write SQL against your actual schema</h3>
              <p>Your editor knows the columns exposed by upstream assets, so IntelliSense is grounded in the pipeline you are actually building.</p>
            </div>
          </article>

          <article class="card span-3">
            <div class="card-visual image-pad">
              <Image src={validationImage} alt="Monaco editor showing SQL validation hover for an unresolved column" widths={[320, 480, 640]} sizes="(max-width: 1100px) calc(100vw - 88px), 512px" format="webp" loading="lazy" decoding="async" />
            </div>
            <div class="card-content">
              <div class="card-tag">Validation</div>
              <h3>Catch broken columns before you run</h3>
              <p>See unresolved columns and similar mistakes while you type instead of learning about them from a failed scheduled run.</p>
            </div>
          </article>

          <!--
          <article class="card span-2">
            <div class="card-visual media-fill">
              <img src="/landing/feature-jump-to-def.gif" alt="Renart editor navigating from a SQL reference to its definition" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-tag">Navigation</div>
              <h3>Jump to referenced assets</h3>
              <p>Move from a dependency reference to the source asset without leaving the IDE.</p>
            </div>
          </article>
          -->

          <article class="card span-6">
            <div class="card-visual media-fill">
              <Image src={dagCanvas} alt="Renart DAG canvas showing connected Bruin assets" widths={[480, 720, 960, 1200]} sizes="(max-width: 1100px) calc(100vw - 40px), 766px" format="webp" loading="lazy" decoding="async" />
            </div>
            <div class="card-content">
              <div class="card-tag">Canvas</div>
              <h3>See every dependency before you touch a file</h3>
              <p>The pipeline canvas is not a static diagram. Open any node, inspect lineage, and edit the underlying Bruin asset from the same surface.</p>
            </div>
          </article>

          <article class="card span-6 workflow-card" id="workflow">
            <div class="workflow-grid">
              <div>
                <div class="card-tag">Execution</div>
                <h3>Preview without side effects. Run when you are sure.</h3>
                <p>Use inspect to preview results conservatively, then materialize explicitly when you want the asset to execute for real.</p>
              </div>
              <div>
                <div class="card-tag">Sync</div>
                <h3>The CLI and the UI stay aligned</h3>
                <p>Use Renart alongside your editor and the Bruin CLI. External file edits reconcile back into the UI instead of drifting out of sync.</p>
              </div>
              <div>
                <div class="card-tag">Git</div>
                <h3>Every visual change is a reviewable diff</h3>
                <p>Renart is designed for Git-native workflows, so visual edits still become normal project file changes your team can review and commit.</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="manifesto">
        <blockquote>
          Your pipeline should not be something you have to <em>imagine in your head</em> while reading YAML and SQL files.
        </blockquote>
        <div class="attrib">The thesis behind Renart</div>
      </section>

      <section class="block bruin" id="bruin">
        <div class="eyebrow"><span class="bar"></span> Built on Bruin</div>
        <h2 class="h2">Not another abstraction layer. <em>A better interface</em> to the real thing.</h2>
        <p class="lede">
          Every pipeline you build in Renart remains a native Bruin project: real files on disk, runnable from the CLI, and ready for Git review.
        </p>

        <div class="bruin-grid">
          <div class="bruin-list">
            <div class="bruin-row"><span class="check">✓</span><span><b>Bruin assets on disk.</b> Edit SQL, Python, and YAML files through a git-native IDE.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>All edits go through project files.</b> Renart does not store your pipeline in a proprietary database.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>Use the CLI alongside the UI.</b> Changes made outside Renart sync back automatically.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>Inspect and materialize.</b> Preview results safely, then run assets intentionally when needed.</span></div>
            <div class="bruin-row"><span class="check">✓</span><span><b>Canvas-first lineage.</b> Understand dependencies visually while staying close to source files.</span></div>
          </div>
          <div class="bruin-illus-wrap" hidden>
          <div class="bruin-illus" aria-hidden="true">
            <svg viewBox="0 0 360 340" preserveAspectRatio="xMidYMid meet">
              <path d="M180 60 L180 130" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 3" fill="none" />
              <path d="M180 180 L180 260" stroke="var(--line-3)" stroke-width="1.2" fill="none" />
              <path d="M120 285 L240 285" stroke="var(--line-3)" stroke-width="1.2" fill="none" stroke-dasharray="3 3" />
            </svg>
            <div class="bruin-pill renart" style="top: 32px; left: 50%; transform: translateX(-50%);"><span class="ico">R</span>Renart</div>
            <div class="bruin-pill bruin" style="top: 134px; left: 50%; transform: translateX(-50%);"><span class="ico">B</span>Bruin project</div>
            <div class="bruin-pill git" style="top: 250px; left: 24px;"><span class="ico">G</span>Git repo</div>
            <div class="bruin-pill wh" style="top: 250px; right: 24px;"><span class="ico">W</span>Warehouse</div>
          </div>
          <p class="bruin-caption">Renart is the IDE layer. Bruin remains the pipeline project model, with files in Git and execution against your warehouse.</p>
          </div>
        </div>
      </section>

      <section class="final">
        <h2>Install and open your <em>first pipeline</em>.</h2>
        <p>Get Renart running locally, open your repository, and see your pipeline canvas in minutes.</p>
        <div class="ctas">
          <a href="/docs/installation/" class="btn btn-primary">Get started</a>
          <a href={repoUrl} class="btn btn-ghost">View on GitHub <span class="arrow">-&gt;</span></a>
        </div>
        <div class="install install-final">
          <span class="install-cmd"><span class="prompt">$</span><span>{installCommand}</span></span>
          <button class="install-copy" type="button" data-copy-command={installCommand}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M3 11V4a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.4" /></svg>
            <span class="copy-label">copy</span>
          </button>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="foot-brand">
          <a href="/" class="logo"><img class="logo-mark" src="/icons/icon.svg" alt="" width="22" height="22" />renart</a>
          <p>An IDE for git-native data pipelines. Open source under Apache 2.0.</p>
        </div>
        <div class="foot-col">
          <h5>Product</h5>
          <ul>
            <li><a href="#features">Features</a></li>
            <li><a href="#workflow">Workflow</a></li>
            <li><a href="#bruin">Bruin</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h5>Resources</h5>
          <ul>
            <li><a href="/docs/">Docs</a></li>
            <li><a href="/docs/installation/">Installation</a></li>
            <li><a href="/docs/quickstart/">Quickstart</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h5>Community</h5>
          <ul>
            <li><a href={repoUrl}>GitHub</a></li>
            <li><a href={bruinUrl}>Bruin</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {currentYear} Renart / Apache 2.0</span>
          <div class="meta">
            <span>{latestVersion}</span>
          </div>
      </div>
    </footer>

    <div class="toast" id="toast">copied to clipboard</div>

    <script is:inline>
      document.querySelectorAll('.install-copy').forEach((button) => {
        button.addEventListener('click', async () => {
          const command = button.getAttribute('data-copy-command') || '';
          await navigator.clipboard?.writeText(command);
          document.querySelectorAll('.install-copy').forEach((copyButton) => {
            copyButton.classList.add('copied');
            const label = copyButton.querySelector('.copy-label');
            if (label) label.textContent = 'copied';
            window.setTimeout(() => {
              copyButton.classList.remove('copied');
              if (label) label.textContent = 'copy';
            }, 1400);
          });
          const toast = document.getElementById('toast');
          toast?.classList.add('show');
          window.clearTimeout(window.__renartToastTimeout);
          window.__renartToastTimeout = window.setTimeout(() => toast?.classList.remove('show'), 1600);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0d0c;
    --bg-1: #0f1211;
    --bg-2: #14181a;
    --bg-3: #1a1f1d;
    --line: #1f2522;
    --line-2: #2a322e;
    --line-3: #3a4541;
    --fg: #e9ece9;
    --fg-2: #b9c1bd;
    --fg-3: #7a857f;
    --fg-4: #525c57;
    --fg-5: #3a423e;
    --accent: #6ee7a4;
    --accent-2: #34d17a;
    --accent-3: #1a6b2a;
    --accent-soft: rgba(110, 231, 164, 0.1);
    --accent-soft-2: rgba(110, 231, 164, 0.18);
    --accent-glow: rgba(52, 209, 122, 0.18);
    --warn: #f0b429;
    --serif: var(--font-instrument-serif), Georgia, Cambria, 'Times New Roman', Times, serif;
    --sans: var(--font-geist), system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --mono: var(--font-geist-mono), 'SFMono-Regular', 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace;
    --r-1: 4px;
    --r-2: 6px;
    --r-3: 8px;
    --r-4: 12px;
    --r-5: 16px;
    --shadow-card: 0 1px 0 0 rgba(255, 255, 255, 0.03) inset, 0 12px 32px -16px rgba(0, 0, 0, 0.6);
    --shadow-pop: 0 24px 60px -16px rgba(0, 0, 0, 0.7), 0 0 0 1px var(--line);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -2;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: -1px -1px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 0%, transparent 70%);
    pointer-events: none;
  }
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 600px 400px at 50% -100px, var(--accent-glow), transparent 70%);
    pointer-events: none;
  }
  a { color: inherit; text-decoration: none; }
  code, .mono { font-family: var(--mono); font-size: 0.92em; }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(16px) saturate(1.4);
    background: rgba(11, 13, 12, 0.65);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 28px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .logo-mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: block;
    box-shadow: 0 0 0 1px var(--accent-soft-2), 0 4px 16px -4px var(--accent-glow);
  }
  .nav-links { display: flex; gap: 4px; align-items: center; margin-left: 12px; }
  .nav-link { padding: 6px 12px; font-size: 14px; color: var(--fg-3); border-radius: var(--r-2); transition: color 0.15s, background 0.15s; }
  .nav-link:hover { color: var(--fg); background: var(--bg-2); }
  .nav-right { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .nav-stars, .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--r-2);
    font-size: 13px;
    font-weight: 500;
  }
  .nav-stars { border: 1px solid var(--line-2); color: var(--fg-2); }
  .nav-stars svg { width: 14px; height: 14px; fill: currentColor; }
  .nav-icon-link { width: 32px; height: 32px; justify-content: center; padding: 0; }
  .nav-cta { background: var(--fg); color: var(--bg); }

  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 144px 28px 80px;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 8px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg-1);
    font-size: 12px;
    color: var(--fg-3);
    margin-bottom: 36px;
    font-family: var(--mono);
  }
